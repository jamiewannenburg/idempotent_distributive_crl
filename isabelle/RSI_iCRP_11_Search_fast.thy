theory RSI_iCRP_11_Search_fast
  imports Main
begin

text \<open>
  Faster variant of @{verbatim "RSI_iCRP_11_Search"} (same question: is there
  an 11-element 1-generated RSI iCRP?).  Two changes:

  \<^enum> 1-generation is encoded directly by a ranking instead of an inductive
    set.  @{text "r :: 'a \<Rightarrow> nat"} is injective (with @{text "card nat = card 'a"}
    it is a bijection onto @{text "{0..<n}"}), the generator has rank 0, \<open>e\<close>
    has rank 1 (unless \<open>e = g\<close>), and every other element is \<open>a\<cdot>b\<close> or
    \<open>a\<rightarrow>b\<close> for some \<open>a, b\<close> of strictly smaller rank.  For a finite algebra
    this is equivalent to "generated by \<open>g\<close>": rank elements by the stage at
    which they enter the subuniverse generated by \<open>g\<close>; conversely induction
    on rank puts every element in it.  Fixing \<open>g\<close> and \<open>e\<close> and requiring the
    ranking also breaks part of the symmetry Nitpick otherwise has to search.
    The Mace4 analogue is @{verbatim "input/rsi_icrp_1gen_direct.in"}.

  \<^enum> Redundant constraints (\<open>icrp_extra\<close>) that hold in every iCRP.  Sources
    are given per line; all were also checked on the 1383 RSI iCRPs of size
    2..8 in @{verbatim "model_outputs/rsi_icrp-n.model"}.  They are NOT used
    by the lemmas below: on 2026-10-24 they made Nitpick slower (card 8:
    20 s \<rightarrow> 74 s; card 9 with only the equational order added: 355 s \<rightarrow> 612 s).
    Add @{text "icrp_extra dot arr e le"} to the assumptions to try them.

  Timings (ubuntu desktop, Isabelle2025, max_threads = 1): baseline
  inductive encoding card 8 found in 21 s, card 9 none in 401 s; this
  ranking encoding card 8 found in 19 s, card 9 none in 355 s.
\<close>

definition icrp_axioms ::
  "('a \<Rightarrow> 'a \<Rightarrow> 'a) \<Rightarrow> ('a \<Rightarrow> 'a \<Rightarrow> 'a) \<Rightarrow> 'a \<Rightarrow> ('a \<Rightarrow> 'a \<Rightarrow> bool) \<Rightarrow> bool" where
  "icrp_axioms dot arr e le \<longleftrightarrow>
    (\<forall>x. le x x) \<and>
    (\<forall>x y z. le x y \<and> le y z \<longrightarrow> le x z) \<and>
    (\<forall>x y. le x y \<and> le y x \<longrightarrow> x = y) \<and>
    (\<forall>x y z. dot x (dot y z) = dot (dot x y) z) \<and>
    (\<forall>x y. dot x y = dot y x) \<and>
    (\<forall>x. dot e x = x) \<and>
    (\<forall>x y z. le x y \<longrightarrow> le (dot z x) (dot z y)) \<and>
    (\<forall>x y z. le (dot x y) z \<longleftrightarrow> le y (arr x z)) \<and>
    (\<forall>x. dot x x = x)"

definition icrp_extra ::
  "('a \<Rightarrow> 'a \<Rightarrow> 'a) \<Rightarrow> ('a \<Rightarrow> 'a \<Rightarrow> 'a) \<Rightarrow> 'a \<Rightarrow> ('a \<Rightarrow> 'a \<Rightarrow> bool) \<Rightarrow> bool" where
  "icrp_extra dot arr e le \<longleftrightarrow>
    \<comment> \<open>residuation, trivial; axioms.py: (x<=y)->(y\<rightarrow>z<=x\<rightarrow>z), (x<=y)->(z\<rightarrow>x<=z\<rightarrow>y)\<close>
    (\<forall>x y z. le x y \<longrightarrow> le (arr y z) (arr x z)) \<and>
    (\<forall>x y z. le x y \<longrightarrow> le (arr z x) (arr z y)) \<and>
    \<comment> \<open>residuation, trivial; axioms.py: e \<rightarrow> x = x, (x <= y) <-> (e <= x\<rightarrow>y)\<close>
    (\<forall>x. arr e x = x) \<and>
    (\<forall>x y. le x y \<longleftrightarrow> le e (arr x y)) \<and>
    \<comment> \<open>commutativity + residuation; axioms.py: x\<rightarrow>(y\<rightarrow>z)=y\<rightarrow>(x\<rightarrow>z)\<close>
    (\<forall>x y z. arr x (arr y z) = arr y (arr x z)) \<and>
    \<comment> \<open>hand-added theorems in free_icrp.py / icrp.in\<close>
    (\<forall>x y. le x y \<longleftrightarrow> arr x y = arr (arr x y) (arr x y)) \<and>
    (\<forall>x y. arr x (arr x y) = arr x y) \<and>
    (\<forall>y z. arr (arr (arr y z) z) z = arr y z) \<and>
    (\<forall>x y z. le (dot (arr x y) (arr y z)) (arr x z)) \<and>
    (\<forall>x y. le x (arr y (dot x y)))"

definition rsi :: "'a \<Rightarrow> ('a \<Rightarrow> 'a \<Rightarrow> bool) \<Rightarrow> bool" where
  "rsi e le \<longleftrightarrow> (\<exists>s. \<not> le e s \<and> (\<forall>y. le e y \<or> le y s))"

definition gen_rank ::
  "('a \<Rightarrow> 'a \<Rightarrow> 'a) \<Rightarrow> ('a \<Rightarrow> 'a \<Rightarrow> 'a) \<Rightarrow> 'a \<Rightarrow> 'a \<Rightarrow> ('a \<Rightarrow> nat) \<Rightarrow> bool" where
  "gen_rank dot arr e g r \<longleftrightarrow>
    (\<forall>x y. r x = r y \<longrightarrow> x = y) \<and>
    r g = 0 \<and>
    (e \<noteq> g \<longrightarrow> r e = 1) \<and>
    (\<forall>x. x \<noteq> g \<and> x \<noteq> e \<longrightarrow>
       (\<exists>a b. r a < r x \<and> r b < r x \<and> (x = dot a b \<or> x = arr a b)))"

text \<open>
  Mace4 data (@{verbatim "model_outputs/rsi_icrp-n_one_generated.model"}):
  1-generated RSI iCRPs exist for n = 2..8 and 10, none for n = 9.
  Set @{text "card nat"} equal to @{text "card 'a"}.
\<close>

lemma fast_card4:
  fixes dot arr :: "'a \<Rightarrow> 'a \<Rightarrow> 'a" and e g :: 'a and le :: "'a \<Rightarrow> 'a \<Rightarrow> bool"
    and r :: "'a \<Rightarrow> nat"
  assumes "icrp_axioms dot arr e le" "rsi e le" "gen_rank dot arr e g r"
  shows False
  nitpick [card 'a = 4, card nat = 4, timeout = 120, max_threads = 1,
    format = 2, expect = genuine]
  oops

