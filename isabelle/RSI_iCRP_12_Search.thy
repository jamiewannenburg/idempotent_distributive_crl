theory RSI_iCRP_12_Search
  imports Main
begin

text \<open>
  Nitpick search for 1-generated relatively subdirectly irreducible (RSI)
  idempotent commutative residuated pomonoids (iCRPs), in particular of
  size 11.

  The axioms mirror @{verbatim "input/rsi_icrp.in"} of the
  idempotent_distributive_crl repository (the Mace4 input that produced
  @{verbatim "model_outputs/rsi_icrp-n.model"}):
  \<^item> \<open>\<le>\<close> is a partial order (a separate relation, as in Mace4),
  \<^item> \<open>\<cdot>\<close> is a commutative, associative, idempotent monoid operation with unit \<open>e\<close>,
    monotone in each argument,
  \<^item> \<open>\<rightarrow>\<close> (Mace4's backslash) is the residual: \<open>x\<cdot>y \<le> z \<longleftrightarrow> y \<le> x\<rightarrow>z\<close>,
  \<^item> RSI: there is an element \<open>s\<close> with \<open>e \<notin> \<up>s\<close> such that every element is
    either above \<open>e\<close> or below \<open>s\<close> (the Mace4 axiom
    @{verbatim "exists x (-(e <= x) & all y (e<=y | y<=x))"}).

  One-generation mirrors @{verbatim "one_generated.py"}: some single element
  \<open>g\<close> generates the whole algebra, i.e. the subuniverse generated by \<open>g\<close>
  in the signature \<open>(\<cdot>, \<rightarrow>, e)\<close> is everything.  It is encoded as an
  inductive set, which Nitpick unrolls (option \<open>iter\<close>).

  The algebra is relation/operation-parametric (as in
  @{verbatim "KR_No_Top_Classification_Search"}), so a Nitpick
  "counterexample" to \<open>False\<close> under the assumptions IS an algebra with the
  required properties of exactly \<open>card 'a\<close> elements.
\<close>

definition icrp_axioms ::
  "('a \<Rightarrow> 'a \<Rightarrow> 'a) \<Rightarrow> ('a \<Rightarrow> 'a \<Rightarrow> 'a) \<Rightarrow> 'a \<Rightarrow> ('a \<Rightarrow> 'a \<Rightarrow> bool) \<Rightarrow> bool" where
  "icrp_axioms dot arr e le \<longleftrightarrow>
    (\<forall>x. le x x) \<and>
    (\<forall>x y z. le x y \<and> le y z \<longrightarrow> le x z) \<and>
    (\<forall>x y. le x y \<and> le y x \<longrightarrow> x = y) \<and>
    (\<forall>x y z. dot x (dot y z) = dot (dot x y) z) \<and>
    (\<forall>x y. dot x y = dot y x) \<and>
    (\<forall>x. dot e x = x) \<and>
    (\<forall>x y z. le x y \<longrightarrow> le (dot z x) (dot z y)) \<and>
    (\<forall>x y z. le (dot x y) z \<longleftrightarrow> le y (arr x z)) \<and>
    (\<forall>x. dot x x = x)"

definition rsi :: "'a \<Rightarrow> ('a \<Rightarrow> 'a \<Rightarrow> bool) \<Rightarrow> bool" where
  "rsi e le \<longleftrightarrow> (\<exists>s. \<not> le e s \<and> (\<forall>y. le e y \<or> le y s))"

inductive_set gen ::
  "('a \<Rightarrow> 'a \<Rightarrow> 'a) \<Rightarrow> ('a \<Rightarrow> 'a \<Rightarrow> 'a) \<Rightarrow> 'a \<Rightarrow> 'a \<Rightarrow> 'a set"
  for dot arr e g where
  gen_g:   "g \<in> gen dot arr e g"
| gen_e:   "e \<in> gen dot arr e g"
| gen_dot: "\<lbrakk>a \<in> gen dot arr e g; b \<in> gen dot arr e g\<rbrakk> \<Longrightarrow> dot a b \<in> gen dot arr e g"
| gen_arr: "\<lbrakk>a \<in> gen dot arr e g; b \<in> gen dot arr e g\<rbrakk> \<Longrightarrow> arr a b \<in> gen dot arr e g"

definition one_generated ::
  "('a \<Rightarrow> 'a \<Rightarrow> 'a) \<Rightarrow> ('a \<Rightarrow> 'a \<Rightarrow> 'a) \<Rightarrow> 'a \<Rightarrow> bool" where
  "one_generated dot arr e \<longleftrightarrow> (\<exists>g. \<forall>x. x \<in> gen dot arr e g)"

text \<open>
  Sanity checks against the Mace4 data (@{verbatim "model_outputs/rsi_icrp-n_one_generated.model"}):
  1-generated RSI iCRPs exist for n = 2,3,4,5,6,7,8 and 10 (exactly one of
  size 10, found by Mace4 after 4122 s), and the size-9 file is empty,
  i.e. none of size 9.  Nitpick should report "genuine" for n \<le> 8 and 10,
  and nothing for 9 (only a bounded-search answer; Nitpick cannot prove
  absence).  Tested with Isabelle2025 on the ubuntu desktop (2026-10-24):
  card 4 and card 7 both give a genuine model in about 16 s together, card 8
  in about 40 s.

  Everything between the two marker comments below is a long search.  To
  run only the quick checks in batch, delete that block in a copy, e.g.
  @{verbatim "sed '/(\\*SEARCH-START\\*)/,/(\\*SEARCH-END\\*)/d'"}.
\<close>



(*SEARCH-START*)


text \<open>
  The actual question: is there a 12-element 1-generated RSI iCRP?
  A Nitpick counterexample is such an algebra; "no counterexample found"
  within the timeout settles nothing on its own.
\<close>

lemma no_rsi_icrp_1gen_card12:
  fixes dot arr :: "'a \<Rightarrow> 'a \<Rightarrow> 'a" and e :: 'a and le :: "'a \<Rightarrow> 'a \<Rightarrow> bool"
  assumes "icrp_axioms dot arr e le" "rsi e le" "one_generated dot arr e"
  shows False
  nitpick [card 'a = 12, timeout = 259200, iter = 12, max_threads = 1, verbose, format = 2]
  oops
(*SEARCH-END*)

end
