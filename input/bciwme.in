formulas(assumptions).

x<=x.
(x<=y & y<=z) -> x<=z.
(x<=y & y<=x) -> x=y.

x \ y <= (y \ z) \ (x \ z).
x\(y\z)=y\(x\z).
x\x <= y -> y\y <= y.
(x <= y) <-> ((x \ y) = (x \ y) \ (x \ y)).
x <= (x \ y) \ y.

e = e\e.
e <= x\x.
e \ x = x.
(x <= y) <-> (e <= x\y).

y\(y\x) <= y\x.

x <= x\x.
x\y <= x\(x\y).

end_of_list.

formulas(goals).

(((x \ e) \ e) \ x) \ x = (((((x \ e) \ e) \ x) \ x) \ e) \ e.

end_of_list.

