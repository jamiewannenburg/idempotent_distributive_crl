% 1-generated RSI iCRPs with generation encoded directly (no post-filtering).
% Analogue of Research/KR/RSI_iCRP_11_Search_fast.thy.
%
% set(arithmetic) makes < (and + * <=) built-in integer operations on the
% domain {0..n-1}, so in this file fusion is f(x,y) and the order is le(x,y);
% \ is the residual as in input/rsi_icrp.in.  To compare with the other model
% files rename f -> * in the output.
%
% Generation: the generator is element 0, e is 0 or 1, and every other
% element is f(y,z) or y\z for some y, z with smaller index.  For a finite
% algebra this is equivalent to "0 generates everything" (number the
% elements by when they enter the subalgebra generated by the generator),
% and it also fixes most of the isomorphism freedom.
%
% TIMING (ubuntu, 2026-10-24): SLOW.  Mace4 Skolemizes the exists into two
% functions f1(x), f2(x) and loses its least-number symmetry breaking; size 7
% did not finish in 5 min.  A ground version (explicit disjunction over all
% y, z < x, no set(arithmetic)) found all 7-element ones in 103 s (10 models,
% isomorphic copies), whereas enumerating input/rsi_icrp.in at size 7 and
% filtering is near-instant.  Prefer rsi_icrp_for_1_gen.in + one_generated.py.

set(arithmetic).

if(Mace4).
  assign(max_seconds, -1).
  assign(max_models, -1).
end_if.

formulas(assumptions).

% iCRP (input/rsi_icrp.in with * -> f, <= -> le)
le(x,x).
(le(x,y) & le(y,z)) -> le(x,z).
(le(x,y) & le(y,x)) -> x=y.

f(x,f(y,z)) = f(f(x,y),z).
f(x,y) = f(y,x).
f(e,x) = x.

le(x,y) -> le(f(z,x),f(z,y)).

le(f(x,y),z) <-> le(y,x\z).

x = f(x,x).

% RSI (as in input/rsi_icrp_for_1_gen.in)
-le(e,s) & (le(e,y) | le(y,s)).

% 1-generated by 0
e = 0 | e = 1.
(x != 0 & x != e) -> (exists y exists z (y < x & z < x & (x = f(y,z) | x = y\z))).

end_of_list.

formulas(goals).

end_of_list.
