formulas(assumptions).

%lattice
x^x=x.
x^y=y^x.
x^(y^z)=(x^y)^z.
x v x=x.
x v y=y v x.
x v (y v z)=(x v y) v z.
x ^ (x v y) = x.
x v (x ^ y) = x.

%leq
(x<=y)<->(x v y=y).

%crl
x*y = y*x.
e*x=x.
x*(y*z)=(x*y)*z.
x<=y\(y*x).
x*(x\y) <= y.
x*(y^z)<= (x*y)^(x*z).
(x\y)^(x\z) = x\(y^z).

%idempotent
x=x*x.

%distributive
x^(y v z)=(x^y)v(x^z).

%subdirectly irreducible
exists x all y ( (y <= e & y != e) -> y <= x).

end_of_list.

formulas(goals).

end_of_list.

